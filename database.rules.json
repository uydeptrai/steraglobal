        ".validate": "newData.child('v').val() === 1",
        "v": {
          ".validate": "newData.isNumber()"
        },
        "cur": {
          ".validate": "newData.hasChildren(['t','at'])",
          "t": {
            ".validate": "newData.hasChildren(['id','vid','title','channel','hue'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "vid": {
              ".validate": "newData.isString() && newData.val().length === 11"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "channel": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "dur": {
              ".validate": "newData.isNumber()"
            },
            "hue": {
              ".validate": "newData.isNumber()"
            },
            "votes": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "sk": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "pz": {
